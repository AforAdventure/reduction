# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Get a key at https://www.tripadvisor.com/developers
# The free tier is ~5,000 calls/month. Each city costs roughly
# (1 + venues_fetched) calls per refresh, so 30 cities x 30 venues is ~930.
#
# On GitHub, do NOT commit this value — add it as a repository secret named
# TRIPADVISOR_API_KEY (Settings -> Secrets and variables -> Actions).
TRIPADVISOR_API_KEY=
